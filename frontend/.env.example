# Copy to `.env.local` for local dev — never commit the real `.env.local`.
# Read server-side only (Route Handlers / Server Components) — the backend
# has no CORS configured, so the browser must never call it directly; every
# backend call goes through this app's own Route Handlers (BFF pattern).

# Base URL of the real FastAPI backend (`backend/`, run via
# `uvicorn api.app:create_app --factory --reload`, default port 8000).
BACKEND_API_URL=http://localhost:8000
