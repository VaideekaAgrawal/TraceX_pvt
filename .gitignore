# Ignore virtual environments and IDE artifacts
archive/fund-flow-tracker/venv/
backend/.venv/
backend/.venv313/
.venv/
.vscode/

# Secrets — never commit. backend/foundation/config.py reads from .env.
.env
*.env
!.env.example

# Python cache
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
.coverage
*.log

# Local dev/pilot DB file — schema lives in docs/DATA_SCHEMA.md, the DB
# itself is never committed. Source CSVs under data/ ARE tracked (they're
# the real ingest input for Phase 1/1B), only the generated .db is not.
data/tracex.db
data/uploads/

# Trained ML/RL model artifacts (ROADMAP Phase 3) — generated by
# scripts/train_detection_model.py, never committed; model_runs.artifact_path
# tracks the on-disk location in the DB instead.
data/model_artifacts/

# Node (archived frontend; the rebuilt frontend gets its own .gitignore later)
archive/fund-flow-tracker/frontend/node_modules/
archive/fund-flow-tracker/frontend/.next/

# OS
.DS_Store
Thumbs.db

# uv lockfile — nothing in CI uses uv; this is a local artifact.
backend/uv.lock
