# Ignore virtual environments and IDE artifacts
archive/fund-flow-tracker/venv/
backend/.venv/
backend/.venv313/
.venv/
.vscode/

# Secrets — never commit. backend/foundation/config.py reads from .env.
.env
*.env
*.env.bak*
.env.bak*
!.env.example
docs/LOCAL_DEV_CREDENTIALS.md

# Python cache
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
.coverage
*.log

# The full-scale IBM benchmark DB (~5GB) is generated (2h ingest) and never
# committed — schema lives in docs/DATA_SCHEMA.md. Source CSVs under data/ ARE
# tracked (the real ingest input for Phase 1/1B).
# NOTE: data/tracex_demo.db (the crisp India-centric pilot DB, ~5MB) IS
# committed on purpose — it's the shared pitch dataset so every machine/account
# sees the same demo out of the box. Only tracex.db is excluded here.
data/tracex.db
data/uploads/

# Trained ML/RL model artifacts (ROADMAP Phase 3) — generated by
# scripts/train_detection_model.py, never committed; model_runs.artifact_path
# tracks the on-disk location in the DB instead.
data/model_artifacts/

# Node (archived frontend; the rebuilt frontend gets its own .gitignore later)
archive/fund-flow-tracker/frontend/node_modules/
archive/fund-flow-tracker/frontend/.next/

# OS
.DS_Store
Thumbs.db

# uv lockfile — nothing in CI uses uv; this is a local artifact.
backend/uv.lock
data/reports/

# throwaway demo DB (date-shifted for live demos) — never commit
data/tracex_demo_live.db

# Rendered demo voiceover audio. The WAVs (~60MB) are a build artifact —
# regenerate with `scripts/make_voiceover.py`, which holds the script text and
# is the real source of truth. The MP3s ARE committed (~8MB total): they're the
# actual take the demo video is cut against, and whoever edits the video needs
# the exact audio we timed, not a re-render that could drift by a few hundred ms.
data/voiceover/*.wav
data/voiceover/.tmp/

# Voiceover TTS tooling venv (edge-tts). Local build tool, not app code —
# recreate with: python3 -m venv .venv-tts && .venv-tts/bin/pip install edge-tts
.venv-tts/
