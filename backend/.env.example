# Copy to `.env` for local dev — never commit the real `.env`.
# `foundation/config.py::Settings` reads these; see that module for defaults
# and for which ones `validate_secrets()` requires outside `env=dev`.

ENV=dev
DATABASE_URL=sqlite:///./data/tracex.db

# Required in any non-dev env (Settings.validate_secrets() fails startup
# loudly otherwise) — generate with e.g. `openssl rand -hex 32`. No
# hardcoded default anywhere in code (CLAUDE.md landmine this phase closes).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Required in any non-dev env, and by any script that runs relationship
# discovery (scripts/discover_relationships.py, scripts/generate_demo_data.py,
# scripts/reconcile_relationship_hashes.py) regardless of ENV -- keys the
# HMAC used for relationships.value_hash (foundation/hashing.py). Generate
# with e.g. `openssl rand -hex 32`.
PII_HMAC_SECRET=

# Optional -- LLM gateway (foundation/llm_gateway.py). AI explanation/pattern
# routes degrade to a clean "not configured" message if unset; nothing at
# app-startup time requires it.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-opus-4.8
