# Copy to `.env` for local dev — never commit the real `.env`.
# `foundation/config.py::Settings` reads these; see that module for defaults
# and for which ones `validate_secrets()` requires outside `env=dev`.

ENV=dev
DATABASE_URL=sqlite:///./data/tracex.db

# Required in any non-dev env (Settings.validate_secrets() fails startup
# loudly otherwise) — generate with e.g. `openssl rand -hex 32`. No
# hardcoded default anywhere in code (CLAUDE.md landmine this phase closes).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# ── LLM gateway (Phase 8) ──
# The gateway is the `openai` SDK pointed at LLM_BASE_URL, so any
# OpenAI-compatible endpoint works: OpenRouter today, a self-hosted
# vLLM/TGI/Ollama later, by changing this one URL. OPENROUTER_API_KEY is
# whatever key that base_url expects.
# LLM_MODEL must satisfy two constraints, both learned the hard way (see
# docs/METRICS.md §11):
#   1. It must support function-calling — verify against
#      `GET {LLM_BASE_URL}/models` that `tools` is in `supported_parameters`.
#      Phase 8's tool catalog and grounding contract are unusable without it.
#   2. Prefer a NON-reasoning model. Reasoning models bill hidden reasoning as
#      output tokens AND draw it from the same max_tokens budget as the visible
#      answer, so they end up slower and more expensive per explanation than a
#      pricier-per-token non-reasoning model. Measured: openai/gpt-5 cost 3.8x
#      more per explanation than this default and took 3.5x as long.
# Required outside env=dev.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=

# Keys the HMAC-SHA256 behind `Relationship.value_hash` (Phase 8, decision 9),
# so a leaked DB can't be brute-forced back to the PAN/phone it was derived
# from. Generate with `openssl rand -hex 32`. Required outside env=dev.
# Rotating it means regenerating relationship rows via
# `scripts/discover_relationships.py` — they're derived, not source.
PII_HMAC_KEY=
